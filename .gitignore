# Local credentials; keep the setup template.
.env
.env.*
!.env.example

# Dependencies, build outputs, and tool caches.
node_modules/
dist/
build/
coverage/
.vite/
.cache/
.pytest_cache/
.venv/
__pycache__/
*.py[cod]
.superpowers/
.playwright-mcp/

# All runtime state, solver history, backups, audits, and account sessions.
/data/
/results/
/backups/
/audits/
*.sqlite
*.sqlite3
*.db
*.sqlite-*
*.sqlite3-*
*.db-*
*.sqlite.lock
*.sqlite3.lock
*.db.lock
*.parquet
*.arrow
*.feather
*.jsonl
*.log

# Actual server/range/solver configuration is local. Version examples only.
/config/*
!/config/*.example
.range_order.json
.range_status.json
.range_progress.json
hf_dataset_progress.*

# Dataset-specific operational reports contain solver records and recovery IDs.
/docs/*-audit-20*.md
/docs/*-recovery-20*.md
/docs/*-dataset-mapping-20*.md

tmp/
temp/
